# Copy to .env.local for local work; set the same names in Vercel > Settings > Environment Variables.
#
# --- Browser-visible (the anon key is public by design; Postgres row-level security protects the data) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public key: either name works (Supabase now calls it the "publishable key").
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-PUBLIC-KEY
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Server-only. NEVER give these a VITE_ prefix, or they would be shipped to every visitor. ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional ---
# CLAUDE_MODEL=claude-opus-5-5     # default; any model that supports structured outputs works
# CLAUDE_EFFORT=medium             # low | medium | high | xhigh | max
# CLAUDE_FALLBACKS=off             # disable the server-side refusal fallback if your org rejects it
